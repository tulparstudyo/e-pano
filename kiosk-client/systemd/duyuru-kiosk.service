[Unit]
Description=Dijital Pano Chromium Kiosk Goruntuleyici
After=duyuru-engine.service graphical.target
Wants=duyuru-engine.service

[Service]
Type=simple
User=kiosk
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/kiosk/.Xauthority
ExecStart=/bin/bash /opt/duyuru-kiosk/start-kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
