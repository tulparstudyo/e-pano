[Unit]
Description=Dijital Pano Node.js Senkronizasyon ve Yerel Web Motoru
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/duyuru-kiosk
ExecStart=/usr/bin/node /opt/duyuru-kiosk/engine.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
